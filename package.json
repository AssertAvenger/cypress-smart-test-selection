{
  "name": "cypress-smart-test-selection-monorepo",
  "version": "0.1.0",
  "description": "Intelligent Cypress test selection based on git diffs",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "cypress",
    "test-selection",
    "git-diff",
    "test-impact-analysis",
    "ci",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
