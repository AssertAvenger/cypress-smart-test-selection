{
  "name": "cypress-smart-test-selection-core",
  "version": "2.0.0",
  "description": "Core diff parsing and intelligent mapping logic for Cypress test selection",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cypress",
    "test-selection",
    "git-diff"
  ],
  "author": {
    "name": "Franklin Francis",
    "url": "https://github.com/AssertAvenger"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AssertAvenger/cypress-smart-test-selection.git"
  },
  "homepage": "https://github.com/AssertAvenger/cypress-smart-test-selection#readme",
  "bugs": {
    "url": "https://github.com/AssertAvenger/cypress-smart-test-selection/issues"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "default": "./dist/diff/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "default": "./dist/discovery/index.js"
    },
    "./mapper": {
      "types": "./dist/mapper/index.d.ts",
      "default": "./dist/mapper/index.js"
    }
  }
}
