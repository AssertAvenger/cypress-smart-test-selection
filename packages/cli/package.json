{
  "name": "cypress-smart-test-selection",
  "version": "2.0.1",
  "description": "CLI tool for intelligent Cypress test selection based on git diffs",
  "type": "module",
  "bin": {
    "cy-select": "./dist/bin/cy-select.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cypress",
    "test-selection",
    "git-diff",
    "cli"
  ],
  "author": {
    "name": "Franklin Francis",
    "url": "https://github.com/AssertAvenger"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AssertAvenger/cypress-smart-test-selection.git"
  },
  "homepage": "https://github.com/AssertAvenger/cypress-smart-test-selection#readme",
  "bugs": {
    "url": "https://github.com/AssertAvenger/cypress-smart-test-selection/issues"
  },
  "dependencies": {
    "cypress-smart-test-selection-core": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
